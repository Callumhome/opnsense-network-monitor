# Copy to .env on CT105 and protect with chmod 600.
APP_NAME=OPNsense Network Manager
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8001
APP_API_TOKEN=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./data/network_manager.db

# Configure only after verifying OPNsense API access.
OPNSENSE_URL=https://192.168.1.254
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
OPNSENSE_VERIFY_TLS=true
